  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.11.25",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
